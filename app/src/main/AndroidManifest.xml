<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- v1 needs internet only to call the provider the user chose.
         No MANAGE_EXTERNAL_STORAGE in v1: folders come from the system
         folder picker (OpenDocumentTree) with a persistable URI grant. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Phase 2, Step 5: voice input in chat (SpeechRecognizer). Asked at
         runtime when the mic button is first tapped, never at install. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Phase 2, Step 7: remote mode runs as a foreground service (the
         local HTTP server) with a persistent notification. POST_NOTIFICATIONS
         is asked at runtime from the Remote screen on Android 13+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".CodeSathiApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CodeSathi"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CodeSathi"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Phase 2, Step 7: remote mode. Not exported — only this app
             starts / stops it. dataSync type: it serves data over the LAN. -->
        <service
            android:name=".remote.RemoteService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
